# ── عام ──
PORT=3000
# العنوان العلني للتطبيق (يُستخدم في روابط الدعوات داخل الرسائل). لازم يكون https في الإنتاج.
PUBLIC_BASE_URL=http://localhost:3000
# false = إغلاق التسجيل الجديد بعد إنشاء حسابات المنظّمين
ALLOW_REGISTRATION=true
# مكان حفظ قاعدة البيانات
# DATA_DIR=./data

# ── قناة الدعوات ──
# whatsapp = دعوة بصورة البطاقة وأزرار (قبول / اعتذار / موقع)، sms = رسالة نصية فيها رابط
INVITE_CHANNEL=whatsapp

# ── واتساب (WAHA — محرك WEBJS) ──
# console = وضع تجريبي: تظهر الرسالة في «سجل الرسائل» وتقدر تجرّب خيارات الاستفتاء، بدون إرسال فعلي
# waha    = إرسال فعلي عبر خدمة WAHA (Docker) — انظر README
WHATSAPP_MODE=console
# عنوان خدمة WAHA (داخل نفس السيرفر: 127.0.0.1:3006)
WAHA_BASE_URL=http://127.0.0.1:3006
# مفتاح الوصول إلى WAHA (يُضبط أيضاً في متغير WHATSAPP_API_KEY لحاوية WAHA)
WAHA_API_KEY=
WAHA_SESSION=default
# سر توقيع الـ Webhook (HMAC-SHA512) — ضعه أيضاً في WHATSAPP_HOOK_HMAC_KEY لحاوية WAHA
WAHA_WEBHOOK_HMAC_KEY=
# تباعد بين الرسائل لتقليل خطر الحظر (مللي ثانية)
WAHA_SEND_DELAY_MS=4000
WAHA_SEND_JITTER_MS=3000

# ── الرسائل النصية (SMS) ──
# console = وضع تجريبي (لا يرسل شيئاً ويحفظ الرسائل في سجل الرسائل)
# taqnyat = إرسال فعلي عبر تقنيات
SMS_PROVIDER=console
# اسم المرسِل المعتمد في حسابك لدى المزود
SMS_SENDER=
# مفتاح الـ API (Bearer token) من لوحة تقنيات
SMS_API_KEY=

# ── التذكير ──
# ساعة إرسال تذكير تأكيد الحضور في اليوم السابق للمناسبة (بتوقيت الرياض، 0-23)
REMINDER_HOUR=10
