# ── عام ──
PORT=3000
# العنوان العلني للتطبيق (يُستخدم في روابط الدعوات داخل الرسائل). لازم يكون https في الإنتاج.
PUBLIC_BASE_URL=http://localhost:3000
# false = إغلاق التسجيل الجديد بعد إنشاء حسابات المنظّمين
ALLOW_REGISTRATION=true
# مكان حفظ قاعدة البيانات
# DATA_DIR=./data

# ── قناة الدعوات ──
# whatsapp = دعوة بصورة البطاقة وأزرار (قبول / اعتذار / موقع)، sms = رسالة نصية فيها رابط
INVITE_CHANNEL=whatsapp

# ── واتساب للأعمال (Meta Cloud API) ──
# console = وضع تجريبي: تظهر الرسالة بشكلها في «سجل الرسائل» وتقدر تجرّب الضغط على أزرارها، بدون إرسال فعلي
# cloud   = إرسال فعلي (يتطلب حساب واتساب للأعمال وقوالب معتمدة، انظر README)
WHATSAPP_MODE=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# كلمة سر تكتبها أنت وتضعها نفسها في إعداد الـ Webhook عند Meta
WHATSAPP_VERIFY_TOKEN=
# App Secret من تطبيق Meta (للتحقق من توقيع الـ Webhook)
WHATSAPP_APP_SECRET=
# أسماء القوالب كما أنشأتها في WhatsApp Manager
WHATSAPP_TEMPLATE_INVITE=hayyak_invite
WHATSAPP_TEMPLATE_REMINDER=hayyak_reminder
WHATSAPP_LANG=ar
# WHATSAPP_API_VERSION=v23.0

# ── الرسائل النصية (SMS) ──
# console = وضع تجريبي (لا يرسل شيئاً ويحفظ الرسائل في سجل الرسائل)
# taqnyat = إرسال فعلي عبر تقنيات
SMS_PROVIDER=console
# اسم المرسِل المعتمد في حسابك لدى المزود
SMS_SENDER=
# مفتاح الـ API (Bearer token) من لوحة تقنيات
SMS_API_KEY=

# ── التذكير ──
# ساعة إرسال تذكير تأكيد الحضور في اليوم السابق للمناسبة (بتوقيت الرياض، 0-23)
REMINDER_HOUR=10
